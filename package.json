{
  "name": "carepilot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "docker compose up -d --wait",
    "postinstall": "prisma generate",
    "db:setup": "tsx scripts/setup-local-db.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "csv-parse": "7.0.3",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.20",
    "server-only": "^0.0.1",
    "yauzl": "3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "dotenv": "^17.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "type": "module",
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
