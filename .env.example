# Local development only. Generate fresh values; never commit .env.
DATABASE_URL=postgresql://carepilot_app:REPLACE_RUNTIME_PASSWORD@127.0.0.1:55432/carepilot
DIRECT_DATABASE_URL=postgresql://postgres:REPLACE_OWNER_PASSWORD@127.0.0.1:55432/carepilot
POSTGRES_PASSWORD=REPLACE_OWNER_PASSWORD
RUNTIME_DB_PASSWORD=REPLACE_RUNTIME_PASSWORD
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DEMO_SEED_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_14_CHARACTERS
ALLOW_DEMO_SEED=false
# Encrypts authenticator secrets at rest; generate 32 random bytes as hex.
AUTH_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
